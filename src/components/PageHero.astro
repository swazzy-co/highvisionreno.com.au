---
import Button from './Button.astro';

interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  ctaHref?: string;
  ctaLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  title,
  subtitle,
  image = '/images/hero-toorak.webp',
  ctaHref = '/tell-us-about-your-renovation-project',
  ctaLabel = 'Start a Project',
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section class="page-hero">
  <img class="page-hero__media" src={image} alt="" loading="eager" decoding="async" />
  <div class="page-hero__veil"></div>
  <div class="container page-hero__content reveal">
    <h1>{title}</h1>
    {subtitle && <p class="reveal reveal-delay-1">{subtitle}</p>}
    <div class="btn-row reveal reveal-delay-2">
      <Button href={ctaHref} variant="ghost">{ctaLabel}</Button>
      {secondaryHref && secondaryLabel && (
        <Button href={secondaryHref} variant="ghost">{secondaryLabel}</Button>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    min-height: clamp(22rem, 48vw, 32rem);
    display: grid;
    align-items: end;
    color: var(--color-white);
    overflow: hidden;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: fade 1.2s var(--ease);
  }

  .page-hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 32, 44, 0.35) 0%, rgba(8, 32, 44, 0.72) 100%),
      radial-gradient(circle at 20% 20%, rgba(47, 107, 92, 0.2), transparent 45%);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(5.5rem, 10vw, 7.5rem) clamp(2.5rem, 5vw, 4rem);
    max-width: 46rem;
  }

  .page-hero h1 {
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    max-width: 14ch;
  }

  .page-hero p {
    max-width: 38rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.05rem;
  }
</style>
