---
import { site } from '../data/site';
import Button from './Button.astro';
---

<header class="site-header" data-header>
  <div class="site-header__bar container">
    <button class="site-header__menu" type="button" data-menu-open aria-expanded="false" aria-controls="site-menu">
      <span class="site-header__burger" aria-hidden="true"></span>
      <span>Menu</span>
    </button>

    <a class="site-header__brand" href="/" aria-label={site.name}>
      <span class="site-header__brand-text">High Vision Renovations</span>
    </a>

    <Button href="/tell-us-about-your-renovation-project" class="site-header__cta" variant="ghost">
      Start a Project
    </Button>
  </div>
</header>

<div class="site-menu" id="site-menu" data-menu hidden>
  <div class="site-menu__panel">
    <div class="site-menu__top">
      <button type="button" class="site-menu__close" data-menu-close aria-label="Close menu">Close</button>
      <img src="/images/logo.svg" alt="" width="180" height="48" />
    </div>
    <p class="eyebrow">Main Menu</p>
    <nav aria-label="Primary">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <Button href="/tell-us-about-your-renovation-project" variant="outline">Get Started</Button>
  </div>
  <button class="site-menu__dimmer" type="button" data-menu-close aria-label="Close menu overlay"></button>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    color: var(--color-white);
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .site-header.is-solid {
    background: rgba(8, 32, 44, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .site-header__bar {
    min-height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .site-header__menu {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 0.5rem 0;
  }

  .site-header__burger {
    width: 1.15rem;
    height: 0.85rem;
    border-block: 1.5px solid currentColor;
    position: relative;
  }

  .site-header__burger::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: currentColor;
    transform: translateY(-50%);
  }

  .site-header__brand {
    justify-self: center;
    text-decoration: none;
  }

  .site-header__brand-text {
    font-size: clamp(0.78rem, 1.5vw, 0.95rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-header__cta {
    justify-self: end;
  }

  .site-menu[hidden] {
    display: none;
  }

  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    grid-template-columns: minmax(18rem, 28rem) 1fr;
  }

  .site-menu__panel {
    background: var(--color-white);
    color: var(--color-ink);
    padding: 1.5rem 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    animation: rise 0.45s var(--ease);
  }

  .site-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-menu__close {
    border: 0;
    background: transparent;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .site-menu nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .site-menu nav a {
    display: block;
    padding: 0.45rem 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .site-menu__dimmer {
    border: 0;
    background: rgba(8, 32, 44, 0.45);
    cursor: pointer;
  }

  @media (max-width: 720px) {
    .site-header__brand-text {
      letter-spacing: 0.12em;
      font-size: 0.68rem;
    }

    .site-header__cta span:first-child {
      display: none;
    }

    .site-menu {
      grid-template-columns: 1fr;
    }

    .site-menu__dimmer {
      display: none;
    }
  }
</style>

<script>
  const menu = document.querySelector('[data-menu]');
  const openBtn = document.querySelector('[data-menu-open]');
  const closeBtns = document.querySelectorAll('[data-menu-close]');
  const header = document.querySelector('[data-header]');

  function openMenu() {
    menu?.removeAttribute('hidden');
    openBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.setAttribute('hidden', '');
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  function syncHeader() {
    header?.classList.toggle('is-solid', window.scrollY > 24);
  }

  openBtn?.addEventListener('click', openMenu);
  closeBtns.forEach((btn) => btn.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
  window.addEventListener('scroll', syncHeader, { passive: true });
  syncHeader();
</script>
