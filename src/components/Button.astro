---
interface Props {
  href: string;
  variant?: 'default' | 'ghost' | 'outline' | 'primary';
  class?: string;
}

const { href, variant = 'default', class: className = '' } = Astro.props;
const classes = ['btn', variant !== 'default' ? `btn--${variant}` : '', className]
  .filter(Boolean)
  .join(' ');
---

<a class={classes} href={href}>
  <span><slot /></span>
  <span class="btn__dot" aria-hidden="true">
    <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </span>
</a>
