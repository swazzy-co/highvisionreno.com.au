---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import Button from '../components/Button.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import TestimonialGrid from '../components/TestimonialGrid.astro';
import HoursTable from '../components/HoursTable.astro';
import ContactForm from '../components/ContactForm.astro';
import { services } from '../data/services';
import { projects } from '../data/projects';
import { approachItems, differentiators, definedBy } from '../data/approach';
import { faqs } from '../data/faqs';
import { site } from '../data/site';

const homeFaqs = faqs.filter((f) =>
  [
    'what-is-the-average-cost-of-a-high-end-kitchen-renovation-in-melbourne',
    'how-long-does-a-luxury-kitchen-renovation-typically-take',
    'can-you-help-with-kitchen-design-and-planning-or-do-i-need-my-own-designer',
    'how-much-does-a-luxury-home-extension-cost-in-melbourne',
    'do-i-need-to-move-out-during-a-full-house-renovation',
  ].includes(f.slug),
);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.shortAnswer || f.answer },
  })),
};
---

<BaseLayout
  title="Luxury Renovations Melbourne | High Vision Renovations"
  description={site.description}
  canonicalPath="/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <HomeHero />

  <section class="section">
    <div class="container intro">
      <div class="intro__copy reveal">
        <h1>Home Renovations Melbourne – Extensions, Kitchen & Bathroom Renovations</h1>
        <p>
          High Vision Renovations delivers home renovations, extensions, and full house reconfigurations across Melbourne.
          We specialise in kitchen renovations, bathroom upgrades, and structural layout changes in suburbs such as Toorak,
          Brighton, and Camberwell. Our team manages the full process, including planning, council approvals, design
          coordination, and construction, with clear timelines and practical solutions that align with each home’s layout
          and constraints.
        </p>
        <div class="btn-row">
          <Button href="/renovation-services" variant="outline">View Our Services</Button>
          <Button href="/contact-high-vision-renovations" variant="primary">Get in Touch</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper defined">
    <div class="container">
      <p class="eyebrow">Our work is defined by</p>
      <div class="defined__track" aria-hidden="true">
        <div class="defined__row">
          {[...definedBy, ...definedBy].map((word) => <span>{word}</span>)}
        </div>
      </div>
      <ul class="defined__list">
        {definedBy.map((word) => <li>{word}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header section__header--center">
        <p class="eyebrow">Portfolio</p>
        <h2>Explore Our Latest Renovation Projects</h2>
        <p>
          Discover the exceptional transformations we've completed across Melbourne's most sought-after suburbs. Each
          project showcases our commitment to luxury finishes, innovative design solutions, and meticulous attention to
          detail.
        </p>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <a class="project-card" href={`/renovation-project/${project.slug}`}>
            <img src={project.heroImage} alt={`${project.title} renovation project`} loading="lazy" />
            <div class="project-card__meta">
              <h3>{project.title}</h3>
              <span>View Project</span>
            </div>
          </a>
        ))}
      </div>
      <div class="btn-row" style="justify-content:center;margin-top:2rem">
        <Button href="/renovation-projects" variant="outline">View All Projects</Button>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="section__header section__header--center">
        <p class="eyebrow">What we do</p>
        <h2>Our Services</h2>
      </div>
      <div class="service-grid">
        {services.map((service) => (
          <a class="service-card" href={`/renovation-service/${service.slug}`}>
            <img src={service.image} alt="" loading="lazy" />
            <div>
              <h3>{service.shortTitle}</h3>
              <p>{service.summary}</p>
              <span>Learn more</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header">
        <p class="eyebrow">Process</p>
        <h2>Our Approach to Melbourne Home Renovations</h2>
      </div>
      <div class="approach-grid">
        {approachItems.map((item, i) => (
          <article>
            <span class="approach-grid__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="section__header section__header--center">
        <p class="eyebrow">Difference</p>
        <h2>What Makes High Vision Renovations Different</h2>
        <p>
          Your renovation is a significant investment in your Melbourne home. We combine thoughtful design, skilled
          execution, and genuine partnership to deliver spaces that work beautifully for how you actually live.
        </p>
      </div>
      <div class="diff-grid">
        {differentiators.map((item) => (
          <article>
            <div class="diff-grid__icon" aria-hidden="true"></div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--primary">
    <div class="container contact-band">
      <div>
        <p class="eyebrow" style="color:rgba(255,255,255,0.55)">Contact</p>
        <h2>Get in Touch with High Vision Renovations</h2>
        <p>
          Ready to start your luxury home renovation or extension project in Melbourne? Our team is here to listen to
          your vision and provide expert guidance tailored to your specific needs.
        </p>
        <div class="btn-row">
          <Button href="/tell-us-about-your-renovation-project" variant="ghost">Get a Free Quote</Button>
          <Button href="/faqs" variant="ghost">View FAQs</Button>
        </div>
      </div>
      <HoursTable />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header section__header--center">
        <p class="eyebrow">What our clients say</p>
        <h2>Excellence in every renovation</h2>
      </div>
      <TestimonialGrid />
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="section__header section__header--center">
        <p class="eyebrow">FAQ</p>
        <h2>Frequently Asked Questions</h2>
      </div>
      <FAQAccordion items={homeFaqs} />
      <div class="btn-row" style="justify-content:center;margin-top:1.75rem">
        <Button href="/faqs" variant="outline">Browse All FAQs</Button>
      </div>
    </div>
  </section>

  <ContactForm />
</BaseLayout>

<style>
  .intro {
    max-width: 48rem;
  }

  .intro h1 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .intro p {
    color: var(--color-ink-soft);
    font-size: 1.08rem;
  }

  .defined__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    color: var(--color-primary);
  }

  .defined__track {
    overflow: hidden;
    margin-bottom: 1.25rem;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .defined__row {
    display: flex;
    gap: 2rem;
    width: max-content;
    animation: marquee 28s linear infinite;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 300;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(13, 46, 62, 0.35);
  }

  .project-grid,
  .service-grid,
  .diff-grid,
  .approach-grid {
    display: grid;
    gap: 1.25rem;
  }

  .project-grid {
    grid-template-columns: 1.15fr 0.85fr;
  }

  .project-card {
    position: relative;
    display: block;
    min-height: 22rem;
    overflow: hidden;
    border-radius: var(--radius-md);
    color: white;
    text-decoration: none;
  }

  .project-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    transition: transform 0.7s var(--ease);
  }

  .project-card:hover img {
    transform: scale(1.04);
  }

  .project-card__meta {
    position: absolute;
    inset: auto 0 0;
    padding: 1.5rem;
    background: linear-gradient(transparent, rgba(8, 32, 44, 0.78));
  }

  .project-card h3 {
    margin: 0 0 0.35rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 1rem;
  }

  .project-card span {
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .service-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .service-card {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.1rem;
    padding: 1rem;
    background: white;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .service-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-soft);
    color: inherit;
  }

  .service-card img {
    width: 100%;
    height: 8.5rem;
    object-fit: cover;
    border-radius: 0.8rem;
  }

  .service-card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.15rem;
  }

  .service-card p {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .service-card span {
    display: inline-block;
    margin-top: 0.7rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .approach-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .approach-grid article {
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-line);
  }

  .approach-grid__n {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--color-muted);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
  }

  .approach-grid p,
  .diff-grid p {
    color: var(--color-ink-soft);
  }

  .diff-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .diff-grid article {
    padding: 1.4rem;
    background: white;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line);
  }

  .diff-grid__icon {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--color-primary);
    margin-bottom: 1rem;
    position: relative;
  }

  .diff-grid__icon::after {
    content: '';
    position: absolute;
    inset: 0.85rem;
    border: 1.5px solid white;
    border-radius: 2px;
  }

  .contact-band {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2.5rem;
    align-items: center;
  }

  .contact-band h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
  }

  .contact-band > div > p {
    color: rgba(255, 255, 255, 0.78);
  }

  @media (max-width: 960px) {
    .project-grid,
    .service-grid,
    .approach-grid,
    .diff-grid,
    .contact-band {
      grid-template-columns: 1fr;
    }

    .service-card {
      grid-template-columns: 7.5rem 1fr;
    }
  }
</style>
