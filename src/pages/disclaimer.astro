---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Disclaimer | High Vision Renovations Melbourne"
  description="Review High Vision Renovations' disclaimer. Important legal information regarding our luxury renovation services, warranties, and client responsibilities in Melbourne."
  canonicalPath="/disclaimer"
>
